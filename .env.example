# Copy to .env and adjust if needed. No secrets are required.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Comma separated Lingva instances, tried in order
LINGVA_INSTANCES=https://lingva.ml
LINGVA_TIMEOUT=6
TRANSLATE_MAX_CHARS=300
TRANSLATE_RATE_LIMIT=30
# Extra origins allowed to call /api cross-origin (frontend is same-origin by default)
CORS_ORIGINS=

